# Public Supabase project URL used by the browser application.
# Example: https://your-project-ref.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# Public Supabase publishable/anon key used by the browser application.
# Never place a service-role key or other server secret in any NUXT_PUBLIC_* variable.
NUXT_PUBLIC_SUPABASE_KEY=

# Canonical SNCBT-AMS origin. Leave this value as the production URL on Cloudflare;
# override it only for a deliberate staging/development deployment.
NUXT_PUBLIC_APP_URL=https://sncbt-assess.autox.workers.dev

# Monitored inbox used by /.well-known/security.txt (RFC 9116).
SECURITY_CONTACT_EMAIL=

# Optional. Set true only while intentionally testing PWA/service-worker behavior
# under the local Nuxt development server.
NUXT_PWA_DEV=false

# Maintenance mode for the web application.
# LOCAL DEVELOPMENT: keep false so you can access and test the full system.
# PRODUCTION MAINTENANCE: set true (or rely on the temporary source default).
# AFTER MAINTENANCE: set false in Cloudflare and redeploy before reopening access.
NUXT_PUBLIC_MAINTENANCE_MODE=false
