# Optional: point E2E tests at a deployed SNCBT Assess instance.
# Leave blank to let Nuxt Test Utils start the local Nuxt server.
E2E_BASE_URL=

# Set false only when you want to watch a browser locally.
E2E_HEADLESS=true

# Broad smoke budgets. Tighten these after you establish stable baselines.
E2E_MAX_API_MS=8000
E2E_MAX_PAGE_LOAD_MS=15000

# Public Supabase values are required for API/integration tests and local Nuxt startup.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Use dedicated NON-PRODUCTION test accounts.
E2E_STUDENT_IDENTIFIER=
E2E_STUDENT_PASSWORD=
E2E_INSTRUCTOR_IDENTIFIER=
E2E_INSTRUCTOR_PASSWORD=
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Optional read-only fixture IDs for deeper smoke coverage.
E2E_STUDENT_ASSESSMENT_ID=
E2E_INSTRUCTOR_ASSESSMENT_ID=

# E2E_BROWSER and E2E_BROWSER_CHANNEL are assigned automatically by the
# Vitest projects. You normally do not need to set them here.
