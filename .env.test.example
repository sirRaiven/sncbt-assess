# Optional: point E2E tests at a deployed SNCBT Assess instance.
# Leave blank to let Playwright start the local Nuxt dev server.
E2E_BASE_URL=

# Public Supabase values are required for local Nuxt startup when the app needs them.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Use dedicated NON-PRODUCTION test accounts.
E2E_STUDENT_IDENTIFIER=
E2E_STUDENT_PASSWORD=
E2E_INSTRUCTOR_IDENTIFIER=
E2E_INSTRUCTOR_PASSWORD=
E2E_ADMIN_IDENTIFIER=
E2E_ADMIN_PASSWORD=

# Optional read-only fixture IDs for deeper smoke coverage.
E2E_STUDENT_ASSESSMENT_ID=
E2E_INSTRUCTOR_ASSESSMENT_ID=
