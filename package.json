{
  "name": "sncbt-assess",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:unit:coverage": "vitest run --project unit --coverage",
    "test:repo": "node --test tests/repository/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "npm run test:unit && npm run test:nuxt && npm run test:repo && npm run lint && npm run typecheck",
    "verify": "npm run check && npm run build",
    "verify:full": "npm run verify && npm run test:integration && npm run test:e2e",
    "test:nuxt": "vitest run --project nuxt",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/supabase": "^2.0.9",
    "eslint": "^10.8.0",
    "nuxt": "^4.5.1",
    "read-excel-file": "^9.3.4",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.12.0",
    "playwright-core": "^1.62.1",
    "supabase": "^2.111.0",
    "vitest": "^4.1.11"
  }
}
